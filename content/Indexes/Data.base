views:
  - type: table
    name: Table
    filters:
      and:
        - "!file.ctime.isEmpty()"
        - '!file.hasTag("Hub")'
        - '!file.name.endsWith("base")'
    order:
      - file.name
      - file.ctime
      - file.mtime
    sort:
      - property: file.size
        direction: DESC
      - property: file.ctime
        direction: DESC
